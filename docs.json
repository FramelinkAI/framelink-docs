{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Framelink",
  "colors": { "primary": "#0D9373" },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.framelink.ai"
  },
  "favicon": {
    "light": "/logo/favicon-light.svg",
    "dark": "/logo/favicon-dark.svg"
  },
  "navbar": {
    "links": [{ "type": "discord", "href": "https://discord.gg/MeE3UEjdGN" }],
    "primary": { "type": "github", "href": "https://github.com/GLips/Figma-Context-MCP" }
  },
  "navigation": {
    "groups": [
      { "group": "Get started", "pages": ["index", "quickstart"] },
      {
        "group": "Guides",
        "pages": ["authentication", "http-server", "best-practices", "troubleshooting"]
      },
      { "group": "Reference", "pages": ["configuration", "fetch", "tools"] }
    ]
  },
  "redirects": [{ "source": "/alternate-methods", "destination": "/http-server" }],
  "contextual": { "options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode"] }
}
